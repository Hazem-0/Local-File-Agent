<Window x:Class="LocalFileAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocalFileAgent.App"
        xmlns:search="clr-namespace:LocalFileAgent.Application.Search;assembly=LocalFileAgent.Application"
        mc:Ignorable="d"
        Title="{DynamicResource AppTitle}" 
        Height="800" 
        Width="1100"
        MinHeight="550"
        MinWidth="780"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI Variable Display, Segoe UI, Tahoma, Arial"
        FontSize="14"
        Background="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Card elevation shadow -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.05" />
        <DropShadowEffect x:Key="SubtleShadow" BlurRadius="6" Direction="270" ShadowDepth="1" Color="#0F172A" Opacity="0.04" />

        <!-- Style for Badges -->
        <Style x:Key="BadgeBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Base Flat Button Style with Smooth Hover -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style (Open / Folder) -->
        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#93C5FD" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clickable Path Hyperlink Button -->
        <Style x:Key="PathLinkButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PathBorder" 
                                Background="#F1F5F9" 
                                BorderBrush="#E2E8F0" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔗" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DisplayPath}" 
                                           FlowDirection="LeftToRight"
                                           Foreground="#2563EB" 
                                           FontSize="12" 
                                           FontWeight="Medium"
                                           TextDecorations="Underline"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PathBorder" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="PathBorder" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Clean Text Box Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#3B82F6" />
                                <Setter TargetName="BoxBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Row 0: Modern Header -->
            <RowDefinition Height="Auto" /> <!-- Row 1: Search & Agent Card -->
            <RowDefinition Height="Auto" /> <!-- Row 2: Indexing Progress Alert -->
            <RowDefinition Height="*" />    <!-- Row 3: Results Area -->
            <RowDefinition Height="Auto" /> <!-- Row 4: Status Footer -->
        </Grid.RowDefinitions>

        <!-- Row 0: Modern Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Title & Tagline -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#4F46E5" CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LocalFileAgent" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="#0F172A" />
                </StackPanel>
            </StackPanel>

            <!-- Top Actions & Stats -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Files count pill -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="4,0" Effect="{StaticResource SubtleShadow}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📁" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="الملفات: " Foreground="#64748B" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding IndexedFilesCount}" Foreground="#0F172A" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Chunks count pill -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="4,0" Effect="{StaticResource SubtleShadow}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧩" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="المقاطع: " Foreground="#64748B" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding IndexedChunksCount}" Foreground="#0F172A" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Index Folder Button -->
                <Button Click="OnIndexFolderClick"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#4F46E5"
                        BorderBrush="#4338CA"
                        Foreground="White"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource IndexFolder}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Clear Index Button -->
                <Button Click="OnClearIndexClick"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        Foreground="#DC2626"
                        ToolTip="مسح كافة الملفات والمقاطع المفهرسة من قاعدة بيانات التطبيق"
                        Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="مسح الفهرس" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Search Box & Agent Card -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="12" 
                Padding="16" 
                BorderBrush="#E2E8F0" 
                BorderThickness="1" 
                Effect="{StaticResource CardShadow}"
                Margin="0,0,0,16">
            <StackPanel>
                <!-- Search Input & Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnSearchBoxKeyDown" />

                    <!-- Quick Search Button -->
                    <Button Grid.Column="1"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#2563EB"
                            BorderBrush="#1D4ED8"
                            Foreground="White"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="بحث فوري" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Ask Agent Button -->
                    <Button Grid.Column="2"
                            Command="{Binding AskAgentCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#7C3AED"
                            BorderBrush="#6D28D9"
                            Foreground="White"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤖" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="اسأل الوكيل الذكي" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Clear Button -->
                    <Button Grid.Column="3"
                            Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#F1F5F9"
                            BorderBrush="#E2E8F0"
                            Foreground="#64748B"
                            Margin="8,0,0,0">
                        <TextBlock Text="✕ مسح" FontSize="13" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <!-- Agent Grounded Answer Card (Collapsible, scrollable, polished) -->
                <Border Background="#FAF5FF"
                        BorderBrush="#C4B5FD"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,14,0,0"
                        Effect="{StaticResource SubtleShadow}"
                        Visibility="{Binding IsAgentMode, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Agent Header Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🤖 إجابة الوكيل الذكي الموثقة:" FontWeight="Bold" Foreground="#6B46C1" FontSize="14" VerticalAlignment="Center"/>
                                <Border Background="#DCFCE7" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsAnswerGrounded, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="✓ موثقة بالكامل من الملفات" Foreground="#15803D" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </StackPanel>

                            <!-- Close Agent Card Button -->
                            <Button Grid.Column="1"
                                    Command="{Binding CloseAgentAnswerCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#A855F7"
                                    Cursor="Hand"
                                    ToolTip="إغلاق إجابة الوكيل"
                                    Padding="4,2">
                                <TextBlock Text="✕ إغلاق" FontSize="12" FontWeight="SemiBold" />
                            </Button>
                        </Grid>

                        <!-- Formatted Answer Text Container -->
                        <ScrollViewer Grid.Row="1" MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding AgentAnswerText}"
                                       TextWrapping="Wrap"
                                       Foreground="#334155"
                                       FontSize="13.5"
                                       LineHeight="22"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, Tahoma, Arial" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Search Live Status Row -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search status message -->
                    <TextBlock Text="{Binding StatusMessage}" 
                               VerticalAlignment="Center" 
                               Foreground="#0284C7" 
                               FontWeight="Medium"
                               FontSize="13" />

                    <!-- Searching indicator -->
                    <ProgressBar Grid.Column="1"
                                 Width="120" 
                                 Height="5" 
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisConverter}}" 
                                 VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 2: Indexing Progress Notification (shown when indexing) -->
        <Border Grid.Row="2"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,14"
                Effect="{StaticResource SubtleShadow}"
                Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="140" Height="6" IsIndeterminate="True" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding IndexingMessage}" Foreground="#1E40AF" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{DynamicResource Cancel}"
                        Command="{Binding CancelIndexingCommand}"
                        Style="{StaticResource ModernButtonStyle}"
                        Padding="12,4"
                        Background="#EF4444"
                        BorderBrush="#DC2626"
                        Foreground="White"
                        FontSize="12" />
            </Grid>
        </Border>

        <!-- Row 3: Modern Search Results List -->
        <Border Grid.Row="3" 
                Background="White" 
                CornerRadius="12" 
                BorderBrush="#E2E8F0" 
                BorderThickness="1" 
                Effect="{StaticResource CardShadow}"
                Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Results List Header -->
                <Border Grid.Row="0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,10,12,10" Margin="4,0,4,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="نتائج البحث والمطابقات" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,8,0"/>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} نتيجة'}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="انقر نقراً مزدوجاً على أي بطاقة أو انقر على المسار لفتح الملف مباشرة" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Cards ListView -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding Results}"
                          SelectedItem="{Binding SelectedResult}"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type search:SearchResultViewModel}">
                            <!-- Interactive Result Card with Elevation -->
                            <Border Margin="4,5" 
                                    Padding="14" 
                                    Background="White" 
                                    CornerRadius="10" 
                                    BorderBrush="#E2E8F0" 
                                    BorderThickness="1"
                                    Effect="{StaticResource SubtleShadow}"
                                    MouseLeftButtonDown="OnResultItemMouseDoubleClick">
                                <StackPanel>
                                    <!-- Top Row: File Icon + File Name + Badges -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- File Icon & Name (Clickable) -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- File Type Pill -->
                                            <Border CornerRadius="6" 
                                                    Padding="6,3" 
                                                    Margin="0,0,10,0" 
                                                    Background="{Binding FileTypeBadgeBg}" 
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FileTypeIcon}" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Extension}" FontSize="11" FontWeight="Bold" Foreground="{Binding FileTypeBadgeFg}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Clickable File Name -->
                                            <Button Command="{Binding OpenFileCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Cursor="Hand"
                                                    ToolTip="انقر لفتح هذا الملف فوراً">
                                                <TextBlock Text="{Binding DisplayFileName}" 
                                                           FontWeight="Bold" 
                                                           FontSize="15" 
                                                           Foreground="#1D4ED8" 
                                                           VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Badges: Source, Page, Score -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Source badge (OCR / VLM / Text) -->
                                            <Border Style="{StaticResource BadgeBorderStyle}" Background="{Binding SourceBadgeBg}">
                                                <TextBlock Text="{Binding SourceKindDisplay}" FontSize="11" Foreground="{Binding SourceBadgeFg}" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Page badge -->
                                            <Border Style="{StaticResource BadgeBorderStyle}" Background="#F1F5F9"
                                                    Visibility="{Binding PageDisplay.Length, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="{Binding PageDisplay}" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Relevance badge -->
                                            <Border Style="{StaticResource BadgeBorderStyle}" Background="#ECFDF5">
                                                <TextBlock Text="{Binding ScorePercentDisplay}" FontSize="11" Foreground="#059669" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Middle Row: Clickable File Path & Direct Actions (The User's Request) -->
                                    <Grid Margin="0,8,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Clickable Path Button -->
                                        <Button Style="{StaticResource PathLinkButtonStyle}"
                                                Command="{Binding OpenFileCommand}"
                                                ToolTip="انقر لفتح الملف مباشرة" />

                                        <!-- Direct Action Buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Open File Button -->
                                            <Button Style="{StaticResource CardActionButtonStyle}"
                                                    Command="{Binding OpenFileCommand}"
                                                    ToolTip="فتح الملف في البرنامج الافتراضي"
                                                    Margin="6,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="↗️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="فتح الملف" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Open Containing Folder Button -->
                                            <Button Style="{StaticResource CardActionButtonStyle}"
                                                    Command="{Binding OpenFolderCommand}"
                                                    ToolTip="عرض الملف في مستكشف ويندوز"
                                                    Margin="6,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📂" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="في المجلد" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Delete from Index Button -->
                                            <Button Style="{StaticResource CardActionButtonStyle}"
                                                    Command="{Binding DataContext.DeleteFromIndexCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="إلغاء فهرسة هذا الملف وإزالته من قاعدة بيانات التطبيق"
                                                    Margin="6,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🗑️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="حذف من الفهرس" Foreground="#DC2626" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bottom Row: Highlighted Snippet Preview -->
                                    <Border Background="#F8FAFC" 
                                            CornerRadius="6" 
                                            Padding="10,8" 
                                            BorderBrush="#F1F5F9" 
                                            BorderThickness="1"
                                            Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock local:SnippetHighlightBehavior.Runs="{Binding SnippetRuns}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   LineHeight="21"
                                                   Foreground="#334155" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Friendly Empty State Watermark -->
                <StackPanel Grid.Row="1" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Visibility="{Binding Results.Count, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Results.Count}" Value="0" />
                                        <Condition Binding="{Binding IsSearching}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.4"/>
                    <TextBlock Text="لم يتم العثور على أي نتائج تطابق البحث" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#64748B" 
                               HorizontalAlignment="Center"/>
