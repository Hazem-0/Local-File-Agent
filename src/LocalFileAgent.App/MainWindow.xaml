<Window x:Class="LocalFileAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocalFileAgent.App"
        xmlns:search="clr-namespace:LocalFileAgent.Application.Search;assembly=LocalFileAgent.Application"
        mc:Ignorable="d"
        Title="LocalFileAgent — أداة البحث والأرشفة المحلية" 
        Height="780" 
        Width="1020"
        MinHeight="560" 
        MinWidth="740"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Cairo, Arial"
        FontSize="13"
        Background="#ECEFE6">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Muted Army & Dialog Brushes -->
        <SolidColorBrush x:Key="ArmyTitlebarBrush" Color="#2C3823" />
        <SolidColorBrush x:Key="ArmyTitlebarTextBrush" Color="#F0F4EC" />
        <SolidColorBrush x:Key="ArmyBorderBrush" Color="#445437" />
        <SolidColorBrush x:Key="GroupBorderBrush" Color="#B8C4AD" />
        <SolidColorBrush x:Key="DialogBgBrush" Color="#ECEFE6" />
        <SolidColorBrush x:Key="TacticalYellowBrush" Color="#EAB308" />
        <SolidColorBrush x:Key="YellowHighlightBrush" Color="#FEF08A" />
        <SolidColorBrush x:Key="YellowSelectBrush" Color="#FEF9C3" />

        <!-- Classic GroupBox Style (Fieldset / Legend) -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#B8C4AD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" 
                                   FontWeight="Bold" 
                                   FontSize="12" 
                                   Foreground="#2C3823" 
                                   Padding="6,0" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Classic Push Button Style -->
        <Style x:Key="ClassicButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#E2E7DC" />
            <Setter Property="BorderBrush" Value="#9AA88F" />
            <Setter Property="Foreground" Value="#1A2414" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F0F4EA" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#6D7D61" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#D4DED0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default (Primary) Classic Button Style -->
        <Style x:Key="DefaultButtonStyle" TargetType="Button" BasedOn="{StaticResource ClassicButtonStyle}">
            <Setter Property="Background" Value="#34432A" />
            <Setter Property="BorderBrush" Value="#212C1A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DefBorder" Property="Background" Value="#425536" />
                                <Setter TargetName="DefBorder" Property="BorderBrush" Value="#2A3821" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DefBorder" Property="Background" Value="#26331E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DefBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Classic Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ClassicButtonStyle}">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Setter Property="Foreground" Value="#991B1B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DngBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DngBorder" Property="Background" Value="#FEE2E2" />
                                <Setter TargetName="DngBorder" Property="BorderBrush" Value="#EF4444" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DngBorder" Property="Background" Value="#FECACA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DngBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Row Action Button Style -->
        <Style x:Key="MiniRowButtonStyle" TargetType="Button" BasedOn="{StaticResource ClassicButtonStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <!-- Keyword Chip Button Style -->
        <Style x:Key="KeywordChipButtonStyle" TargetType="Button" BasedOn="{StaticResource ClassicButtonStyle}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="Background" Value="#F2F5ED" />
            <Setter Property="BorderBrush" Value="#C0CEB8" />
            <Setter Property="Foreground" Value="#2D3E24" />
        </Style>

        <!-- Classic Input Text Box Style -->
        <Style x:Key="ClassicTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="BorderBrush" Value="#8E9E81" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#2C3823" />
                                <Setter TargetName="BoxBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListView Item Style with Soft Yellow Selection Highlight -->
        <Style x:Key="ClassicListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="#E2E7DC"
                                BorderThickness="0,0,0,1"
                                Padding="8,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F4F7EF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FEF9C3" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#CA8A04" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Row 0: Army Title Bar with Search App Icon -->
            <RowDefinition Height="*" />    <!-- Row 1: Responsive Main Content Container -->
            <RowDefinition Height="Auto" /> <!-- Row 2: Clean Status Bar -->
        </Grid.RowDefinitions>

        <!-- Row 0: Army Title Bar with Search App Icon -->
        <Border Grid.Row="0" Background="#2C3823" BorderBrush="#445437" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search App Icon & App Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1C2616" BorderBrush="#EAB308" BorderThickness="1.5" CornerRadius="3" Width="26" Height="26" Margin="0,0,10,0">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 8 2 A 6 6 0 1 0 8 14 A 6 6 0 1 0 8 2 Z M 12.5 12.5 L 17 17 M 8 5 L 8 11 M 5 8 L 11 8"
                              Stroke="#FACC15" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <TextBlock Text="LocalFileAgent — أداة البحث والأرشفة الميدانية"
                               Foreground="#F0F4EC"
                               FontSize="13.5"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- App Stats Badge -->
                <Border Grid.Column="1" Background="#1C2616" BorderBrush="#445437" BorderThickness="1" CornerRadius="2" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IndexedFilesCount, StringFormat='{}الأرشيف: {0} وثيقة'}" 
                               Foreground="#D0DECA" 
                               FontSize="11.5" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Row 1: Responsive Main Content (Dynamic Grid) -->
        <Grid Grid.Row="1" Margin="14,10,14,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Group 1: Local Archive Management -->
                <RowDefinition Height="Auto" /> <!-- Group 2: Search with TOP Loading Indicator -->
                <RowDefinition Height="Auto" /> <!-- Group 3: Spacious Formatted Agent Answer (when active) -->
                <RowDefinition Height="*" />    <!-- Group 4: Responsive Matched Archived Documents Table -->
                <RowDefinition Height="Auto" /> <!-- Group 5: Archived Snippet Preview -->
            </Grid.RowDefinitions>

            <!-- GROUP 1: LOCAL ARCHIVE MANAGEMENT -->
            <GroupBox Grid.Row="0" Header="إدارة الأرشيف الميداني والمجلدات">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Current Archived Folder Indicator -->
                    <Border Background="#F2F5ED" BorderBrush="#CCD6C4" BorderThickness="1" CornerRadius="2" Padding="8,5" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="المسار المؤرشف حالياً: " FontWeight="Bold" Foreground="#2A3821" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding CurrentDirectoryPath}" 
                                       FlowDirection="LeftToRight"
                                       Foreground="#203318" 
                                       FontFamily="Consolas, 'Courier New', monospace"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" 
                                       TextTrimming="CharacterEllipsis" 
                                       Margin="6,0" />
                            <TextBlock Grid.Column="2" 
                                       Text="{Binding IndexedFilesCount, StringFormat='[ {0} وثيقة مؤرشفة ]'}" 
                                       Foreground="#475C3A" 
                                       FontWeight="Bold" 
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Archive Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Click="OnIndexFolderClick"
                                Style="{StaticResource DefaultButtonStyle}"
                                ToolTip="اختر مجلداً من القرص لأرشفة وثائقه وفهرستها محلياً">
                            <TextBlock Text="أرشفة مجلد جديد..." VerticalAlignment="Center" />
                        </Button>

                        <Button Command="{Binding UpdateArchiveCommand}"
                                Click="OnUpdateArchiveClick"
                                Style="{StaticResource ClassicButtonStyle}"
                                ToolTip="إعادة فحص وتحديث الأرشيف للتحقق من أي وثائق جديدة أو معدلة"
                                Margin="6,0,0,0">
                            <TextBlock Text="تحديث الأرشيف" VerticalAlignment="Center" />
                        </Button>

                        <Button Click="OnClearIndexClick"
                                Style="{StaticResource DangerButtonStyle}"
                                ToolTip="مسح كافة الوثائق المفهرسة من قاعدة بيانات التطبيق"
                                Margin="6,0,0,0">
                            <TextBlock Text="مسح الأرشيف" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- GROUP 2: SEARCH IN ARCHIVE WITH TOP LOADING INDICATOR -->
            <GroupBox Grid.Row="1" Header="البحث في الأرشيف المحلي">
                <StackPanel>
                    <!-- 1. PRIMARY SEARCH BAR ROW -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="نص البحث:" 
                                   FontWeight="Bold" 
                                   Foreground="#2A3821" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0" />

                        <TextBox Grid.Column="1"
                                 x:Name="SearchBox"
                                 Style="{StaticResource ClassicTextBoxStyle}"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnSearchBoxKeyDown"
                                 ToolTip="اكتب موضوع أو سؤال أو استفسار البحث الأساسي" />

                        <Button Grid.Column="2"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource DefaultButtonStyle}"
                                Margin="8,0,0,0">
                            <TextBlock Text="بحث في الأرشيف" VerticalAlignment="Center" />
                        </Button>

                        <Button Grid.Column="3"
                                Command="{Binding AskAgentCommand}"
                                Style="{StaticResource ClassicButtonStyle}"
                                ToolTip="استخراج إجابة موثقة واستدلالية من الوثائق"
                                Margin="6,0,0,0">
                            <TextBlock Text="تحليل الوكيل" VerticalAlignment="Center" />
                        </Button>

                        <Button Grid.Column="4"
                                Command="{Binding ClearSearchCommand}"
                                Style="{StaticResource ClassicButtonStyle}"
                                Margin="6,0,0,0">
                            <TextBlock Text="مسح الكل" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- 2. DEDICATED KEYWORDS BAR WITH INTEGRATED CARDS & INPUT -->
                    <Border Margin="0,8,0,0" 
                            Background="#F5F8F0" 
                            BorderBrush="#C5D1BD" 
                            BorderThickness="1" 
                            CornerRadius="2" 
                            Padding="8,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Keywords Bar Input Row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="شريط الكلمات المفتاحية:" 
                                               FontWeight="Bold" 
                                               Foreground="#2B3C21" 
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <Border Visibility="{Binding HasKeywords, Converter={StaticResource BoolToVisConverter}}"
                                            Background="#E3EBDC" 
                                            BorderBrush="#9EB58F" 
                                            BorderThickness="1" 
                                            CornerRadius="2" 
                                            Padding="6,1" 
                                            Margin="6,0,0,0" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KeywordsSummary}" 
                                                   Foreground="#28401C" 
                                                   FontWeight="Bold" 
                                                   FontSize="11" 
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <TextBox Grid.Column="1"
                                         x:Name="AdditionalPhraseBox"
                                         Style="{StaticResource ClassicTextBoxStyle}"
                                         KeyDown="OnAdditionalPhraseKeyDown"
                                         ToolTip="أدخل كلمة مفتاحية أو أكثر (مفصولة بفواصل)، واضغط Enter للإضافة السريعة أو Esc للتفريغ" />

                                <Button Grid.Column="2"
                                        Click="OnAddPhraseClick"
                                        Style="{StaticResource ClassicButtonStyle}"
                                        Margin="6,0,0,0"
                                        ToolTip="إضافة الكلمة كبطاقة مفتاحية مستقلة داخل شريط الكلمات">
                                    <TextBlock Text="+ إضافة بطاقة" VerticalAlignment="Center" />
                                </Button>

                                <Button Grid.Column="3"
                                        Command="{Binding ClearKeywordsCommand}"
                                        IsEnabled="{Binding HasKeywords}"
                                        Style="{StaticResource ClassicButtonStyle}"
                                        Margin="6,0,0,0"
                                        FontSize="11"
                                        ToolTip="مسح كافة بطاقات الكلمات المفتاحية النشطة">
                                    <TextBlock Text="مسح البطاقات" VerticalAlignment="Center" />
                                </Button>
                            </Grid>

                            <!-- Active Keyword Cards / Empty State Area (Inside Keywords Bar) -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <!-- Empty state hint when no keywords are active -->
                                <Border Visibility="{Binding HasNoKeywords, Converter={StaticResource BoolToVisConverter}}"
                                        Background="#FAFCF7"
                                        BorderBrush="#DEE6D5"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Padding="8,5">
                                    <TextBlock Text="[ لا توجد بطاقات كلمات مفتاحية نشطة — اكتب كلمة واضغط Enter أو انقر على المقترحات أدناه لفلترة أدق ]"
                                               Foreground="#637754"
                                               FontSize="11.5"
                                               FontStyle="Italic"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Active Keyword Cards WrapPanel -->
                                <ItemsControl Visibility="{Binding HasKeywords, Converter={StaticResource BoolToVisConverter}}"
                                              ItemsSource="{Binding Keywords}" 
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- INDIVIDUAL KEYWORD CARD -->
                                            <Border BorderThickness="1" 
                                                    CornerRadius="2" 
                                                    Padding="7,3" 
                                                    Margin="0,2,6,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#8E9E81" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#EDF3E6" />
                                                                <Setter Property="BorderBrush" Value="#3B5226" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="6" Height="6" Background="#4A6536" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding}" 
                                                               Foreground="#1A2414" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="12" 
                                                               VerticalAlignment="Center" 
                                                               Margin="0,0,6,0" />
                                                    <Button Click="OnRemoveKeywordCardClick"
                                                            Tag="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="2,0"
                                                            Cursor="Hand"
                                                            ToolTip="إزالة هذه البطاقة المفتاحية">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="CloseBorder" Background="Transparent" CornerRadius="2" Padding="2,0">
                                                                    <TextBlock x:Name="CloseText" Text="✕" Foreground="#991B1B" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="CloseBorder" Property="Background" Value="#FEE2E2" />
                                                                        <Setter TargetName="CloseText" Property="Foreground" Value="#DC2626" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 3. QUICK PRESET KEYWORDS (ADDS CARDS TO KEYWORDS BAR) -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="إضافة بطاقة سريعة:" 
                                   FontSize="11" 
                                   Foreground="#4B633C" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0" />

                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Style="{StaticResource KeywordChipButtonStyle}" Content="+ فاتورة" Click="OnQuickKeywordClick" ToolTip="تبديل بطاقة كلمة فاتورة (إضافة/إزالة)" />
                            <Button Style="{StaticResource KeywordChipButtonStyle}" Content="+ عقد توريد" Click="OnQuickKeywordClick" ToolTip="تبديل بطاقة عقد توريد (إضافة/إزالة)" />
                            <Button Style="{StaticResource KeywordChipButtonStyle}" Content="+ سند قبض" Click="OnQuickKeywordClick" ToolTip="تبديل بطاقة سند قبض (إضافة/إزالة)" />
                            <Button Style="{StaticResource KeywordChipButtonStyle}" Content="+ تقرير مالي" Click="OnQuickKeywordClick" ToolTip="تبديل بطاقة تقرير مالي (إضافة/إزالة)" />
                            <Button Style="{StaticResource KeywordChipButtonStyle}" Content="+ ٢٠٢٥" Click="OnQuickKeywordClick" ToolTip="تبديل بطاقة سنة ٢٠٢٥ (إضافة/إزالة)" />
                            <Button Style="{StaticResource KeywordChipButtonStyle}" Content="+ مسح ضوئي OCR" Click="OnQuickKeywordClick" ToolTip="تبديل بطاقة مسح ضوئي OCR (إضافة/إزالة)" />
                            <Button Style="{StaticResource KeywordChipButtonStyle}" Content="+ أمر شراء" Click="OnQuickKeywordClick" ToolTip="تبديل بطاقة أمر شراء (إضافة/إزالة)" />
                            <Button Style="{StaticResource KeywordChipButtonStyle}" Content="+ شروط الضمان" Click="OnQuickKeywordClick" ToolTip="تبديل بطاقة شروط الضمان (إضافة/إزالة)" />
                        </WrapPanel>
                    </Grid>

                    <!-- PROMINENT TOP LOADING INDICATORS (CLEAR & VISIBLE) -->
                    <!-- Searching progress bar -->
                    <Grid Margin="0,8,0,0" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="جاري فحص ومطابقة الوثائق في الأرشيف..." 
                                   Foreground="#166534" 
                                   FontWeight="Bold" 
                                   FontSize="12" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,10,0" />
                        <ProgressBar Grid.Column="1" 
                                     Height="6" 
                                     IsIndeterminate="True" 
                                     Foreground="#16A34A" 
                                     Background="#E2E7DC" 
                                     VerticalAlignment="Center" />
                    </Grid>

                    <!-- Indexing progress bar -->
                    <Grid Margin="0,8,0,0" Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ProgressBar Grid.Row="0" 
                                     Height="7" 
                                     IsIndeterminate="True" 
                                     Foreground="#16A34A" 
                                     Background="#E2E7DC" />
                        <TextBlock Grid.Row="1" 
                                   Text="{Binding IndexingMessage}" 
                                   Foreground="#166534" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   Margin="0,4,0,0" 
                                   HorizontalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- GROUP 3: SPACIOUS & WELL-FORMATTED AGENT ANSWER BOX -->
            <GroupBox Grid.Row="2" 
                      Header="تحليل واستدلال الوكيل الذكي من الأرشيف"
                      Visibility="{Binding IsAgentMode, Converter={StaticResource BoolToVisConverter}}"
                      Background="#FDFCF8"
                      BorderBrush="#CA8A04">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Agent Header Actions -->
                        <RowDefinition Height="*" />    <!-- Formatted Scrollable Text -->
                    </Grid.RowDefinitions>

                    <!-- Header Row -->
                    <Border Grid.Row="0" Margin="0,0,0,8" Background="#FBF7E9" Padding="6,4" CornerRadius="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="إفادة الوكيل المستخلصة من الوثائق:" FontWeight="Bold" Foreground="#854D0E" FontSize="12.5" VerticalAlignment="Center"/>
                                <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsAnswerGrounded, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="[موثقة بالكامل من الأرشيف]" Foreground="#166534" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Copy Answer Button -->
                                <Button Click="OnCopyAgentAnswerClick"
                                        Style="{StaticResource ClassicButtonStyle}"
                                        Padding="8,2"
                                        FontSize="11"
                                        ToolTip="نسخ نص الإفادة كاملاً إلى الحافظة">
                                    <TextBlock Text="نسخ الإفادة" VerticalAlignment="Center" />
                                </Button>

                                <!-- Close Answer Button -->
                                <Button Command="{Binding CloseAgentAnswerCommand}"
                                        Style="{StaticResource ClassicButtonStyle}"
                                        Padding="8,2"
                                        FontSize="11"
                                        Margin="6,0,0,0"
                                        ToolTip="إغلاق نافذة الإفادة">
                                    <TextBlock Text="إغلاق الإفادة" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Spacious Formatted Answer Container -->
                    <ScrollViewer Grid.Row="1" MinHeight="110" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <Border Background="#FFFFFF" BorderBrush="#E9E2CE" BorderThickness="1" Padding="12,10">
                            <TextBlock Text="{Binding AgentAnswerText}"
                                       TextWrapping="Wrap"
                                       Foreground="#1A2416"
                                       FontSize="13.5"
                                       LineHeight="23"
                                       FontFamily="Segoe UI, Tahoma, Cairo" />
                        </Border>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <!-- GROUP 4: RESPONSIVE MATCHED ARCHIVED DOCUMENTS TABLE -->
            <GroupBox Grid.Row="3" Header="{Binding TotalCount, StringFormat='الوثائق المؤرشفة المطابقة ({0} ملفات)'}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Table Header Row -->
                        <RowDefinition Height="*" />    <!-- Table Items List -->
                    </Grid.RowDefinitions>

                    <!-- Classic Table Column Header Row -->
                    <Border Grid.Row="0" Background="#E2E7DC" BorderBrush="#CCD5C3" BorderThickness="1,1,1,1" Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" /> <!-- File Name -->
                                <ColumnDefinition Width="2.5*" /> <!-- Path -->
                                <ColumnDefinition Width="0.7*" /> <!-- Type -->
                                <ColumnDefinition Width="1.2*" /> <!-- OCR / Source -->
                                <ColumnDefinition Width="0.9*" /> <!-- Relevance -->
                                <ColumnDefinition Width="1.2*" /> <!-- Direct Action -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="اسم الوثيقة المؤرشفة" FontWeight="Bold" Foreground="#26331E" FontSize="11.5" />
                            <TextBlock Grid.Column="1" Text="المسار في الأرشيف" FontWeight="Bold" Foreground="#26331E" FontSize="11.5" />
                            <TextBlock Grid.Column="2" Text="النوع" FontWeight="Bold" Foreground="#26331E" FontSize="11.5" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="المصدر / OCR" FontWeight="Bold" Foreground="#26331E" FontSize="11.5" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="الصلة" FontWeight="Bold" Foreground="#26331E" FontSize="11.5" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="إجراء سريع" FontWeight="Bold" Foreground="#26331E" FontSize="11.5" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Table Data Rows -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CCD5C3" BorderThickness="1,0,1,1">
                        <ListView ItemsSource="{Binding Results}"
                                  SelectedItem="{Binding SelectedResult}"
                                  ItemContainerStyle="{StaticResource ClassicListViewItemStyle}"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListView.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             FlowDirection="RightToLeft" 
                                             FontFamily="Segoe UI, Tahoma">
                                    <MenuItem Header="فتح الملف" Command="{Binding OpenFileCommand}" CommandParameter="{Binding SelectedResult}" FontWeight="Bold" />
                                    <MenuItem Header="عرض موقع الملف في المجلد" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedResult}" />
                                    <Separator />
                                    <MenuItem Header="إزالة هذه الوثيقة من الأرشيف" Command="{Binding DeleteFromIndexCommand}" CommandParameter="{Binding SelectedResult}" Foreground="#DC2626" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type search:SearchResultViewModel}">
                                    <Grid MouseLeftButtonDown="OnResultItemMouseDoubleClick">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="0.7*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- File Name (Double-click or click) -->
                                        <TextBlock Text="{Binding DisplayFileName}" 
                                                   FontWeight="Bold" 
                                                   Foreground="#1A2414" 
                                                   VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Path -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding DisplayPath}" 
                                                   FlowDirection="LeftToRight"
                                                   Foreground="#55664C" 
                                                   FontFamily="Consolas, monospace"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   Margin="6,0" />

                                        <!-- Extension Badge -->
                                        <Border Grid.Column="2" Background="#E8EFE3" BorderBrush="#C0CEB8" BorderThickness="1" CornerRadius="2" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Extension}" FontSize="10.5" FontWeight="Bold" Foreground="#2C3D22" />
                                        </Border>

                                        <!-- Source Kind / OCR -->
                                        <TextBlock Grid.Column="3" 
                                                   Text="{Binding SourceKindDisplay}" 
                                                   FontSize="11" 
                                                   Foreground="#445639" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" />

                                        <!-- Relevance Percent -->
                                        <TextBlock Grid.Column="4" 
                                                   Text="{Binding ScorePercentDisplay}" 
                                                   FontWeight="Bold" 
                                                   FontSize="11" 
                                                   Foreground="#15803D" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" />

                                        <!-- Direct Row Actions -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Command="{Binding OpenFileCommand}"
                                                    Style="{StaticResource MiniRowButtonStyle}"
                                                    ToolTip="فتح الملف في البرنامج الافتراضي">
                                                <TextBlock Text="فتح" VerticalAlignment="Center" />
                                            </Button>
                                            <Button Command="{Binding OpenFolderCommand}"
                                                    Style="{StaticResource MiniRowButtonStyle}"
                                                    ToolTip="عرض موقع الملف في المجلد">
                                                <TextBlock Text="المجلد" VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </GroupBox>

            <!-- GROUP 5: ARCHIVED SNIPPET PREVIEW -->
            <GroupBox Grid.Row="4" Header="معاينة المقطع المطابق من داخل الأرشيف">
                <Border Background="#FBFDF9" BorderBrush="#D4DCCB" BorderThickness="1" Padding="10,6" MinHeight="44" MaxHeight="90">
                    <Grid>
                        <!-- Highlighted Snippet -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock local:SnippetHighlightBehavior.Runs="{Binding SelectedResult.SnippetRuns}"
                                       TextWrapping="Wrap"
                                       FontSize="12.5"
                                       LineHeight="19"
                                       Foreground="#222C1D"
                                       Visibility="{Binding SelectedResult.HasSnippet, Converter={StaticResource BoolToVisConverter}}" />
                        </ScrollViewer>

                        <!-- Fallback Placeholder when nothing selected or no snippet -->
                        <TextBlock Text="حدد وثيقة من الجدول أعلاه لمعاينة المقطع المطابق المستخرج عبر الفحص أو تقنية OCR (أو انقر نقراً مزدوجاً لفتحها مباشرة)."
                                   Foreground="#7B8C70"
                                   FontSize="12"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedResult.HasSnippet}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedResult}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </GroupBox>
        </Grid>

        <!-- Row 2: Clean Status Bar (WITHOUT REDUNDANT TEXT / WITHOUT NON-WORKING BUTTONS) -->
        <Border Grid.Row="2" Background="#E2E7DC" BorderBrush="#C0CBB6" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2B3C21" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text=" | " Foreground="#97A78C" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding IndexedFilesCount, StringFormat='المؤرشف: {0} وثيقة'}" Foreground="#415634" FontSize="11.5" VerticalAlignment="Center" />
                    <TextBlock Text=" | " Foreground="#97A78C" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding IndexedChunksCount, StringFormat='المقاطع: {0}'}" Foreground="#415634" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" 
                           Text="انقر نقراً مزدوجاً أو بالزر الأيمن على أي صف لفتح الملف وإدارته" 
                           Foreground="#5D7350" 
                           FontSize="11" 
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
